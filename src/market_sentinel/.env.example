# =============================================================================
# Market Sentinel — Environment Configuration Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values below (never commit the .env file itself)
#   3. The app loads this automatically via python-dotenv
#
# WHERE TO GET THE VALUES:
#   Alpaca keys  → https://app.alpaca.markets  (Paper Trading → API Keys)
#   Gmail pass   → https://myaccount.google.com/apppasswords
#                  (requires 2FA enabled; generate an "App Password")
# =============================================================================


# -----------------------------------------------------------------------------
# Alpaca Markets API
# -----------------------------------------------------------------------------
ALPACA_KEY=your_alpaca_api_key_here          # e.g. PKXXXXXXXXXXXXXXXXXXXXXX
ALPACA_SECRET=your_alpaca_api_secret_here    # e.g. 7fXXXXXXXXXXXXXXXXXXXXXX
ALPACA_PAPER=true                            # true = paper trading (safe default)
                                             # false = LIVE money — use carefully!

# -----------------------------------------------------------------------------
# Email Notifications (SMTP)
# -----------------------------------------------------------------------------
NOTIFY_EMAIL_ENABLED=true                    # set to false to silence emails

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com           # Gmail account used to send alerts
SMTP_PASSWORD=xxxx xxxx xxxx xxxx           # 16-char Gmail App Password (not your login password)
SMTP_USE_TLS=true

NOTIFY_FROM_EMAIL=your_email@gmail.com       # address shown in the From: field
NOTIFY_TO_EMAIL=destination@gmail.com        # where trade alerts are delivered

# -----------------------------------------------------------------------------
# Optional Webhook (Slack / Discord / custom)
# -----------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=                          # leave blank to disable
