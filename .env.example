# ──────────────────────────────────────────────────────
# Market Sentinel — Environment Variables Template
# Copy this file to src/market_sentinel/.env and fill in
# your real credentials.  NEVER commit the .env file.
# ──────────────────────────────────────────────────────

# Alpaca API (paper or live)
ALPACA_KEY=your_alpaca_api_key_here
ALPACA_SECRET=your_alpaca_api_secret_here
ALPACA_PAPER=true          # set to false for live trading

# Email / SMTP notifications
NOTIFY_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=true
NOTIFY_FROM_EMAIL=your_email@gmail.com
NOTIFY_TO_EMAIL=destination_email@gmail.com

# Optional webhook URL (leave blank to disable)
NOTIFY_WEBHOOK_URL=
